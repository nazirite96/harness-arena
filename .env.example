# Copy to .env and fill in. NEVER commit .env.
# ---- Upstream provider key (lives ONLY on the proxy host) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Fixed competition model (LiteLLM model string) ----
# Exposed to all participants under the single alias below.
ARENA_UPSTREAM_MODEL=anthropic/claude-haiku-4-5-20251001
ARENA_MODEL_ALIAS=arena-model
# Context/output limits advertised to opencode for the alias
ARENA_MODEL_CONTEXT=200000
ARENA_MODEL_OUTPUT=32000

# ---- LiteLLM proxy ----
LITELLM_MASTER_KEY=sk-change-me-master
LITELLM_SALT_KEY=sk-change-me-salt-never-rotate
LITELLM_PORT=4000
# Host name the TASK CONTAINERS use to reach the proxy.
#   macOS (Docker Desktop / Colima / OrbStack): host.docker.internal
#   Linux VM: the VM's primary internal IP, e.g. 10.128.0.5
ARENA_PROXY_HOST=host.docker.internal
POSTGRES_PASSWORD=litellm

# ---- Arena app ----
ARENA_DB_PATH=data/arena.sqlite3
ARENA_JOBS_DIR=jobs
ARENA_TEAM_DEV_BUDGET_USD=30
ARENA_COST_CAP_PER_TASK_USD=0.50
ARENA_TASK_TIMEOUT_SEC=1800
ARENA_N_CONCURRENT=16
# SWE-bench images are linux/amd64 only; keep this unless you build your own images.
ARENA_DOCKER_PLATFORM=linux/amd64
ARENA_ADMIN_TOKEN=change-me-admin
ARENA_SLACK_WEBHOOK_URL=

# ---- Public pages (guide / leaderboard) ----
ARENA_EVENT_NAME=Harness Arena 1기
# D1 (kickoff) date, YYYY-MM-DD. Leave empty to show relative days only.
ARENA_D1_DATE=
# Address participants use for the proxy in their local opencode config
ARENA_PROXY_PUBLIC_URL=http://<proxy-host>:4000/v1
# Starter kit repository participants clone
ARENA_STARTER_KIT_URL=https://github.com/<org>/harness-arena-starter-kit
# Public leaderboard URL (shown in the guide)
ARENA_PUBLIC_URL=http://<host>:8000
ARENA_CONTACT=운영진 Slack #harness-arena
